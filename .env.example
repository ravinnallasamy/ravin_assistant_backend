SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Used for the answer-generation LLM (Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key

# Used only for voice question transcription (Groq Whisper), not for
# answer generation
GROQ_API_KEY=your_groq_api_key

PORT=5000

# Comma-separated list of allowed origins for CORS (e.g. your frontend URL).
# No wildcard fallback: requests from origins not in this list are rejected.
CORS_ORIGIN=http://localhost:5173

# Admin password is NOT stored here. Generate a bcrypt hash with:
#   node scripts/hash-password.js <your-password>
# then insert it into the admin.password_hash column in Supabase.
