SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Used for the answer-generation LLM (Groq) and voice question
# transcription (Groq Whisper)
GROQ_API_KEY=your_groq_api_key

# Optional. Groq chat model for answer generation; defaults to
# openai/gpt-oss-120b. Set this if that model is ever decommissioned —
# check available models at https://console.groq.com/docs/models
GROQ_CHAT_MODEL=openai/gpt-oss-120b

PORT=5000

# Comma-separated list of allowed origins for CORS (e.g. your frontend URL).
# No wildcard fallback: requests from origins not in this list are rejected.
CORS_ORIGIN=http://localhost:5173

# Admin password is NOT stored here. Generate a bcrypt hash with:
#   node scripts/hash-password.js <your-password>
# then insert it into the admin.password_hash column in Supabase.
